# ==============================================================================
# Anibros CRM — local development configuration template
#   cp .env.native.example .env.native      (.env.native is gitignored; never commit real secrets)
# Every name below is read by server/src/platform/config.ts. Production requires the ones marked (prod).
# ==============================================================================

# --- Database ---------------------------------------------------------------
# Privileged role: migrations and role provisioning only (npm run db:migrate / db:provision).
MIGRATOR_DATABASE_URL=postgresql://anibros:dev-only-not-a-secret@127.0.0.1:5442/anibros
# Disposable-database host for the test suite (each test file creates and drops its own database).
DATABASE_TEST_URL=postgresql://anibros:dev-only-not-a-secret@127.0.0.1:5442/anibros_test
# Runtime roles the API and the worker connect as (RLS enforced). `npm run db:provision -- --write-env`
# generates them and appends RESTRICTED_* entries here; copy those into these two lines.  (prod)
DATABASE_URL=postgresql://anibros:dev-only-not-a-secret@127.0.0.1:5442/anibros
WORKER_DATABASE_URL=postgresql://anibros:dev-only-not-a-secret@127.0.0.1:5442/anibros

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Where the web app is served; used for e-mail links and CORS.  (prod)
PUBLIC_APP_URL=http://localhost:5174
LOG_LEVEL=info

# --- Secrets (generate fresh values for every real environment) --------------
# >= 32 characters.  (prod)
COOKIE_SECRET=dev-only-cookie-secret-change-me-0123456789
# One or more "id:<64 hex chars>" keys, comma separated, first = active.  (prod)
# FIELD_ENCRYPTION_KEYS=k1:<64 hex characters>

# --- Mail (development: Mailpit from docker-compose, inbox at http://127.0.0.1:8025) -----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Anibros CRM <no-reply@localhost>

# --- Optional providers: features stay disabled (never faked) until these are set ------
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# ANTHROPIC_API_KEY=
